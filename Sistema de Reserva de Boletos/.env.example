# Copiar a .env (en esta misma carpeta) y ajustar las IPs. El .env NO se versiona.
# Las tres maquinas deben tener las TRES IPs iguales; deploy.sh verifica que la de su capa sea suya.
HOST_CAPA_CONSUMIDORES=10.43.99.230
HOST_CAPA_SERVICIOS=10.43.99.217
HOST_CAPA_PERSISTENCIA=10.43.99.253

GT_PUERTO_CLIENTES=5555
GT_PUERTO_RMC=5556
GT_PUERTO_CANCELACION=5557
PUERTO_SP=5558

DB_URL=postgresql+psycopg://srb:srb@localhost:5432/srb
# Replica de solo lectura (puerto 5433 del compose). Las consultas de eventos se leen de ella; si cae, del primario.
# Dejar vacio para usar solo el primario.
DB_REPLICA_URL=postgresql+psycopg://srb:srb@localhost:5433/srb

# Timeouts (ms). El del cliente debe ser > 2 x el de persistencia + 1000 (una RESERVA hace 2 llamadas).
TIMEOUT_PERSISTENCIA_MS=2000
TIMEOUT_MS=6000
HILOS_PERSISTENCIA=4
